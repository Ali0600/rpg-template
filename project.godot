; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RPG Template"
config/description="A reusable 2D top-down RPG template for Godot 4: a deterministic procedural sprite generator plus the generic systems, so building a new game means editing data/ and writing gameplay."
run/main_scene="res://scenes/world/world.tscn"
; Which game the world boots. EMPTY is correct while one game ships: GameSelect answers with
; the only one there is. Add a second and this must name the one that boots, or the boot
; REFUSES rather than guessing - a guessed game presents as the game you meant to run behaving
; strangely. `--game=<id>` overrides it either way, which is how every scripted play session
; names its game. See scripts/data/game_select.gd.
config/game=""
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
Registry="*res://scripts/autoload/registry.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Router="*res://scripts/autoload/router.gd"
AudioBus="*res://scripts/autoload/audio_bus.gd"
Settings="*res://scripts/autoload/settings.gd"
Qa="*res://scripts/autoload/qa.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

; EVERY Control in the game draws in this font, from one setting. Godot loads it into
; ThemeDB.fallback_font and the default theme, so a screen never names a font - and the screen
; that forgot to would draw in the engine's own face and look almost right, which is the class
; of bug this project spends its gates on. tools/smoke_boot.gd pins this value.
;
; Pixel Operator 8 by Jayvee Enaguas, CC0 1.0 (assets/fonts/LICENSE.txt). The "8" face is drawn
; FOR 8 pixels, which is the size every screen here lays out against; the plain family is drawn
; for 16 and asked for 8 is a scaled bitmap, which is the blur it was brought in to remove.
theme/custom_font="res://assets/fonts/pixel_operator_8.ttf"

[importer_defaults]

; A pixel font is drawn at one size and must land on whole pixels. Godot's own defaults are
; grayscale antialiasing, hinting 3 and subpixel positioning 4 (auto) - all three of which
; smear an 8px glyph across two pixels, which is exactly the blur the font replaced. Read off
; the sidecar the engine wrote on the first import rather than recalled, the way the wav block
; above was, and pinned HERE rather than per file for its reason: a per-file setting is a list
; kept by hand, and the next font added comes back with the default nobody re-reads.
;
; Nothing else in the build can see this. A blurred font passes every gate there is, so
; tests/unit/test_ui_chrome.gd asserts these three off the loaded FontFile.
font_data_dynamic={
"antialiasing": 0,
"hinting": 0,
"multichannel_signed_distance_field": false,
"subpixel_positioning": 0
}

; Generated cues are committed as lossless 16-bit PCM and the drift gate compares those
; samples. Godot's WAV importer defaults to compress/mode=2, which is QOA - LOSSY - so the
; stream the game plays would not be the stream the gate checked, and the difference would be
; invisible on every surface anyone looks at.
;
; Pinned here rather than in each generated .wav.import for the reason every list in this
; project is derived: a per-file setting is a list maintained by hand, and the next cue added
; comes back with the default nobody re-reads. Sound is 236 KB per style at mode 0; the
; compression was buying nothing worth this.
wav={
"compress/mode": 0,
"edit/loop_mode": 0,
"edit/normalize": false,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": false,
"force/mono": false
}

