{
	"id": "gb16",
	"cell": [16, 24],
	"_readme": [
		"Pixel art, authored as text. '.' is transparent; '1' '2' '3' are the shadow, base",
		"and light tones of whatever ramp the character assigns to this part's slot; 'o'",
		"forces an outline pixel. Parts carry no colour of their own - that is what lets one",
		"rig dress an entire cast.",
		"",
		"Three views only: front, side, back. The left-facing row is the right-facing row",
		"mirrored, so nothing here is drawn twice.",
		"",
		"Cell is 16x24. Feet sit on row 22 and the generated outline lands on row 23, so",
		"every character in the style shares a ground line. Parts with \"bob\": false do not",
		"ride the walk bounce - the legs and feet carry the stride, and a foot lifted by the",
		"bob would leave that ground line.",
		"",
		"\"frame_map\" reuses drawings across the four walk frames: the two passing poses are",
		"the same picture, so it is authored once."
	],

	"slot_order": {
		"front": ["legs", "shoes", "body", "arms", "hands", "head", "face", "hair"],
		"side": ["legs", "shoes", "body", "arms", "hands", "head", "face", "hair"],
		"back": ["legs", "shoes", "body", "arms", "hands", "head", "hair"]
	},

