[gd_resource type="Resource" script_class="GameManifest" load_steps=6 format=3]

; The game this template ships, and the point of the exercise: it exists entirely as files
; ADDED beside the template. Nothing under scripts/, tools/ or scenes/ was changed to make it
; run - and that stayed true through items and through battles.
;
; It shares the template's game_config.tres ON PURPOSE. A game may bring its own config when
; its design demands one; this game's design does not, and a second instance that varies a
; knob it has no reason to vary turns every difference a player feels into a suspected
; defect. Same feel, different game - stated as a file reference rather than a promise.
;
; The combat definition is its OWN file rather than more fields on that config, because a
; game without battles must not carry battle knobs it will never turn: a null `combat` is the
; template's default and stays a legal shape forever.
;
; The voice is dusk16, matching the sprite style the maps draw in - a triangle wave pitched
; down, where the other two voices are squares. Same cue bank as every other voice: this game
; brings its own SOUND without authoring a single sound.

[ext_resource type="Script" path="res://scripts/data/game_manifest.gd" id="1_manifest"]
[ext_resource type="Resource" path="res://data/game_config.tres" id="2_config"]
[ext_resource type="Script" path="res://games/quest/quest_hooks.gd" id="3_hooks"]
[ext_resource type="Resource" path="res://data/combat/quest_combat.tres" id="4_combat"]
[ext_resource type="Resource" path="res://data/sounds/dusk16.tres" id="5_sound"]

[resource]
script = ExtResource("1_manifest")
id = &"quest"
title = "The Barred Gate"
start_map = &"quest_village"
start_spawn = &"start"
player_character = &"quest_wanderer"
title_music = &"barred_gate"
config = ExtResource("2_config")
combat = ExtResource("4_combat")
sound_style = ExtResource("5_sound")
hooks = ExtResource("3_hooks")
controls_hint = "WASD / arrows to walk    E or space to look    Esc to pause"
