[gd_resource type="Resource" script_class="GameConfig" load_steps=2 format=3]

; The Barred Gate's feel, separate from the demo's. Same speed and reach, but diagonals are
; off: one axis at a time, the pure four-direction movement of the earliest top-down RPGs.
; It is a design decision, and it lives in a file rather than in a build.

[ext_resource type="Script" path="res://scripts/data/game_config.gd" id="1_config"]

[resource]
script = ExtResource("1_config")
id = &"quest"
walk_speed = 48.0
allow_diagonal = false
interact_reach = 12.0
body_size = Vector2(10, 6)
idle_speed_epsilon = 1.0
camera_smoothing = 0.0
