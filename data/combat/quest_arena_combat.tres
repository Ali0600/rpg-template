[gd_resource type="Resource" script_class="CombatDef" load_steps=2 format=3]

; The Barred Gate's fighter again, fought with a sword (docs/DECISIONS.md, M50).
;
; A CONTROL INSTANCE, and the numbers say so: every curve and every turn-fight timing below is
; quest_combat.tres's, value for value, so a player who levels in one game levels at the same fights
; in the other. What differs is `style` and the arena's own numbers - which is exactly what
; test_battle_content holds these two files to, so a difference nobody chose cannot creep in.
;
; The arena numbers are mostly the template's defaults, which come from the Zelda disassemblies
; (docs/GENRE_CONVENTIONS.md §7d): a twelve-frame swing, 48 frames untouchable after a hit and 24 for
; a struck foe, a tile of shove over eight frames, and wanderers turning every 32 to 63 frames. The
; floor is fourteen tiles by four, two short of the widest the screen draws. UNJUDGED BY HAND: every
; one of these is a feel number the owner has not yet held a controller against.

[ext_resource type="Script" path="res://scripts/data/combat_def.gd" id="1_combat"]

[resource]
script = ExtResource("1_combat")
id = &"quest_arena_combat"
style = &"arena"
base_hp = 20
hp_per_level = 4
base_attack = 5
attack_per_level = 2
base_defense = 1
defense_per_level = 1
base_mp = 8
mp_per_level = 3
xp_curve = Array[int]([20, 24])
attack_cue_frames = 72
defend_cue_frames = 84
timed_window_frames = 24
message_frames = 45
arena_tiles = Vector2i(14, 4)
