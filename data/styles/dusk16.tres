[gd_resource type="Resource" script_class="SpriteStyle" load_steps=2 format=3]

; The Barred Gate's look. A third style on the SAME gb16 rig - not one pixel of shape is
; redrawn for it - which is the claim "a game brings its own look" being cashed rather than
; restated.
;
; Where nes16 is bright and hard, this is late evening: everything desaturated toward blue,
; the highlight tone doing most of the work, and one warm ramp (copper) so a face and a
; lantern are the only warm things on screen. The outline is SOLID and very dark, which
; closes the shapes up in low light - a tinted outline disappears when every material is
; already dark.
;
; The timings below MATCH gb16 exactly, and that is the point rather than an oversight. A
; style may move its own way - nes16 does - but the game wearing this one is the template's
; control instance, so the only axis it varies is colour. A gait that differs for no reason
; the design asked for makes every difference a player feels read as a bug.

[ext_resource type="Script" path="res://scripts/data/sprite_style.gd" id="1_style"]

[resource]
script = ExtResource("1_style")
id = &"dusk16"
cell_size = Vector2i(16, 24)
tile_size = 16
rig_id = &"gb16"
tile_bank_id = &"gb16"
ramps = {
"cloth_indigo": ["#1b1b3a", "#34346b", "#5a5a9c"],
"cloth_moss": ["#1d2f22", "#33513a", "#55805e"],
"cloth_rust": ["#3d1f18", "#6b3626", "#9c5a3c"],
"eye": ["#0a0a14", "#14141f", "#2e2e42"],
"hair_ash": ["#2a2a38", "#4a4a5c", "#75758a"],
"hair_black": ["#0f0f1a", "#24243a", "#45455e"],
"hair_copper": ["#3d1f18", "#7a3d22", "#b5703a"],
"leather": ["#241a14", "#4a3626", "#75563c"],
"pants_night": ["#0f1424", "#1f2a45", "#384a6b"],
"pants_slate": ["#14141f", "#2e2e42", "#4a4a5c"],
"skin_dark": ["#4a3026", "#6b4a3c", "#9c7057"],
"skin_light": ["#6b4a3c", "#9c7057", "#c49a75"],
"stone": ["#1f1f2e", "#3a3a4f", "#5c5c75"],
"terrain_bush": ["#0f1a14", "#1d3324", "#2e5236"],
"terrain_grass": ["#14241f", "#24422f", "#3a6b45"],
"terrain_path": ["#2a2438", "#453d54", "#635a75"],
"terrain_water": ["#0f1a2e", "#1f3a5c", "#35608c"]
}
default_ramps = {
"arms": "cloth_indigo",
"body": "cloth_indigo",
"face": "eye",
"hair": "hair_ash",
"hands": "skin_light",
"head": "skin_light",
"legs": "pants_night",
"shoes": "leather"
}
ramp_choices = {
"body": ["cloth_indigo", "cloth_moss", "cloth_rust"],
"hair": ["hair_ash", "hair_black", "hair_copper"],
"head": ["skin_light", "skin_dark"],
"legs": ["pants_night", "pants_slate"]
}
part_choices = {
"body": ["body_tunic", "body_robe"],
"hair": ["hair_short", "hair_long"]
}
outline_mode = 1
outline_color_hex = "#0a0a14"
ui_colors = {
"dim": "#75758a",
"panel": "#0a0a14",
"text": "#e8e0d0"
}
walk_frames = 4
walk_fps = 8
idle_fps = 4
bob_offsets = Array[int]([0, -1, 0, -1])
mirror_left_from_right = true
