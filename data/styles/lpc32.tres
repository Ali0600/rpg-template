[gd_resource type="Resource" script_class="SpriteStyle" load_steps=2 format=3]

; Hand-drawn Liberated Pixel Cup characters, IMPORTED rather than composed. The sheets come
; from the Universal LPC Spritesheet Character Generator by way of data/imports/lpc32/ and
; LpcImport; the ramps and chrome below are still this file's business, because the terrain
; is drawn by the procedural bank (plain32, the gb16 shapes at 32px) and every screen takes
; its colours from the style it is drawn over. The palette is dusk16's, so the two worlds
; can be compared like for like.
;
; LPC frames are 64x64 on 32px tiles, which is why cell_size and tile_size double here and
; the viewport doubles with them (world_scale, M40 phase B). licenses is the GATE: a layer
; whose artist offers none of these families fails the build by name. Both buckets were
; chosen on 2026-09-01 - credit-only AND share-alike - so the composed sheets ship CC-BY-SA;
; assets/generated/lpc32/LICENSE.txt says so and credits.json names every artist.
;
; walk_fps is UNJUDGED: 8 is the template's own gait on a 4-frame cycle, and LPC's is 8 frames,
; so at 8 fps a full stride takes a second. Somebody who has walked it decides.

[ext_resource type="Script" path="res://scripts/data/sprite_style.gd" id="1_style"]

[resource]
script = ExtResource("1_style")
id = &"lpc32"
cell_size = Vector2i(64, 64)
tile_size = 32
world_scale = 2
rig_id = &""
tile_bank_id = &"plain32"
sheets_from = &"lpc"
licenses = Array[String](["CC0", "CC-BY", "OGA-BY", "CC-BY-SA"])
ramps = {
"cloth_indigo": ["#1b1b3a", "#34346b", "#5a5a9c"],
"cloth_moss": ["#1d2f22", "#33513a", "#55805e"],
"cloth_rust": ["#3d1f18", "#6b3626", "#9c5a3c"],
"eye": ["#0a0a14", "#14141f", "#2e2e42"],
"hair_ash": ["#2a2a38", "#4a4a5c", "#75758a"],
"hair_black": ["#0f0f1a", "#24243a", "#45455e"],
"hair_copper": ["#3d1f18", "#7a3d22", "#b5703a"],
"leather": ["#241a14", "#4a3626", "#75563c"],
"pants_night": ["#0f1424", "#1f2a45", "#384a6b"],
"pants_slate": ["#14141f", "#2e2e42", "#4a4a5c"],
"skin_dark": ["#4a3026", "#6b4a3c", "#9c7057"],
"skin_light": ["#6b4a3c", "#9c7057", "#c49a75"],
"stone": ["#1f1f2e", "#3a3a4f", "#5c5c75"],
"terrain_bush": ["#0f1a14", "#1d3324", "#2e5236"],
"terrain_grass": ["#14241f", "#24422f", "#3a6b45"],
"terrain_path": ["#2a2438", "#453d54", "#635a75"],
"terrain_water": ["#0f1a2e", "#1f3a5c", "#35608c"]
}
default_ramps = {}
ramp_choices = {}
part_choices = {}
outline_mode = 1
outline_color_hex = "#0a0a14"
ui_colors = {
"dim": "#75758a",
"panel": "#0a0a14",
"text": "#e8e0d0"
}
walk_frames = 4
walk_fps = 8
idle_fps = 4
bob_offsets = Array[int]([0, -1, 0, -1])
mirror_left_from_right = false
