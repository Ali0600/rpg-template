[gd_resource type="Resource" script_class="EnemyDef" load_steps=2 format=3]

; What the gate was barred against, and the only fight in the game that cannot be fled.
;
; The numbers are the difficulty statement. At level 2 (24 hp, 7 attack, 2 defense) a player
; who times every press wins in four rounds and never drops below 9 health - on every seed. A
; player who times NOTHING needs eight rounds and dies on the Keeper's fourth, even if it
; only ever uses its weaker move. Neither outcome depends on luck, which is the point: this
; fight asks whether you learned the timing, and answers honestly.
;
; The two tonics from the smith are what sit between those two extremes, for a player who
; lands some presses and misses others.

[ext_resource type="Script" path="res://scripts/data/enemy_def.gd" id="1_enemy"]

[resource]
script = ExtResource("1_enemy")
id = &"keeper"
name = "The Keeper"
character = &"quest_keeper"
max_hp = 30
attack = 8
defense = 3
xp = 25
gold = 25
boss = true
moves = [{ "name": "Bar", "power": 0 }, { "name": "Crush", "power": 4 }]
