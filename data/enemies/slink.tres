[gd_resource type="Resource" script_class="EnemyDef" load_steps=2 format=3]

; What nests on the key. FOUR slinks are the whole of level 2 now - the hollow's two fights are
; a pair apiece - and between them they still cannot kill a careless party: 4 damage a hit
; against 20 and 24 health, with a second sword answering back. That is deliberate. The hollow
; is where you learn the timing, and a tutorial that can kill you is a tutorial people reload
; rather than read.
;
; The gold is HALVED from what a single slink paid (4 -> 2) so that a fight pays what that
; fight always paid. Twice the bodies would otherwise be twice the purse, which would quietly
; retune the smith's shop - see docs/DECISIONS.md. The xp is untouched and the CURVE doubled
; instead, which keeps every levelling beat where it was.

; WEAK TO WIND (150%), which is what gives Gale a job. A sweep worth 4 a body against a pair
; is a worse deal than one Ember; at 6 it is the right answer to two small things, so the two
; spells stop being 'the strong one' and 'the other one' and become a choice about what is in
; front of you. Small light things going over in a gale needs no explaining.
;
; 150 rather than 200 deliberately: a third value in the table is the argument for percents
; over tier words - 'weak' and 'resistant' cannot say this, and the day a game wants a fourth
; answer it writes a number instead of asking for a new word. UNJUDGED BY EAR.

[ext_resource type="Script" path="res://scripts/data/enemy_def.gd" id="1_enemy"]

[resource]
script = ExtResource("1_enemy")
id = &"slink"
name = "Slink"
character = &"quest_slink"
max_hp = 10
attack = 3
defense = 1
xp = 5
gold = 2
boss = false
resistances = {
&"wind": 150
}
moves = [{ "name": "Scratch", "power": 0 }, { "name": "Lunge", "power": 2 }]
